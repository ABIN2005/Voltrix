# Base Sepolia public configuration (chain ID 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Public address derived from PRIVATE_KEY; never put the key on this line.
OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
MIN_OPERATOR_BALANCE_WEI=10000000000000000

# Populate only in ignored contracts/.env for a disposable testnet wallet.
# The read-only preflight never reads this value.
PRIVATE_KEY=

# Optional until contract source verification.
BASESCAN_API_KEY=
